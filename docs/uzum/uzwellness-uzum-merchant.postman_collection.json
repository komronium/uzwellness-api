{
  "info": {
    "name": "UzWellness — Uzum Bank Merchant API",
    "description": "Вебхуки, которые Uzum Bank вызывает на стороне UzWellness (api.uzwellness.com).\n\nПеред запуском заполните переменные коллекции: baseUrl, username, password, serviceId, orderId. Переменные transId и amount проставляются автоматически скриптами запросов /create.\n\nПорядок ручного теста: Check → Create → Confirm → Status. Отмена: Check → Create → Reverse → Status.\n\nСпецификация: https://developer.uzumbank.uz/merchant",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "basic",
    "basic": [
      { "key": "username", "value": "{{username}}", "type": "string" },
      { "key": "password", "value": "{{password}}", "type": "string" }
    ]
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://api.uzwellness.com/api/payments/uzum",
      "type": "string"
    },
    { "key": "username", "value": "", "type": "string" },
    { "key": "password", "value": "", "type": "string" },
    { "key": "serviceId", "value": "123123", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "transId", "value": "", "type": "string" },
    { "key": "amount", "value": "0", "type": "string" }
  ],
  "item": [
    {
      "name": "1. Check — проверка возможности оплаты",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('timestamp', Date.now());"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('status = OK', () => pm.expect(body.status).to.eql('OK'));",
              "pm.test('serviceId совпадает', () => pm.expect(String(body.serviceId)).to.eql(pm.collectionVariables.get('serviceId')));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": {{timestamp}},\n  \"params\": {\n    \"order_id\": \"{{orderId}}\"\n  }\n}"
        },
        "url": { "raw": "{{baseUrl}}/check", "host": ["{{baseUrl}}"], "path": ["check"] },
        "description": "Партнёр проверяет, что бронь существует, не отменена и ещё не оплачена. В data возвращаются данные для показа клиенту в приложении Uzum."
      }
    },
    {
      "name": "2. Create — создание транзакции",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.collectionVariables.set('timestamp', Date.now());",
              "// Новый transId на каждый запуск (повтор того же transId вернёт 10010).",
              "const uuid = require('uuid');",
              "pm.collectionVariables.set('transId', uuid.v4());"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('status = CREATED', () => pm.expect(body.status).to.eql('CREATED'));",
              "pm.collectionVariables.set('amount', String(body.amount));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": {{timestamp}},\n  \"transId\": \"{{transId}}\",\n  \"params\": {\n    \"order_id\": \"{{orderId}}\"\n  },\n  \"amount\": {{amount}}\n}"
        },
        "url": { "raw": "{{baseUrl}}/create", "host": ["{{baseUrl}}"], "path": ["create"] },
        "description": "amount — в тийинах и должен точно совпадать с суммой брони в UZS, иначе 10011. Транзакция, не подтверждённая за 30 минут, считается неуспешной."
      }
    },
    {
      "name": "3. Confirm — подтверждение оплаты",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('timestamp', Date.now());"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('status = CONFIRMED', () => pm.expect(body.status).to.eql('CONFIRMED'));",
              "pm.test('confirmTime заполнен', () => pm.expect(body.confirmTime).to.be.a('number'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": {{timestamp}},\n  \"transId\": \"{{transId}}\",\n  \"paymentSource\": \"UZCARD\",\n  \"tariff\": null,\n  \"processingReferenceNumber\": \"000\",\n  \"phone\": \"998901234567\",\n  \"cardType\": 2\n}"
        },
        "url": { "raw": "{{baseUrl}}/confirm", "host": ["{{baseUrl}}"], "path": ["confirm"] },
        "description": "После подтверждения бронь переходит в статус confirmed и гостю уходит письмо. Повторный вызов вернёт 10016."
      }
    },
    {
      "name": "4. Reverse — отмена транзакции",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('timestamp', Date.now());"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('status = REVERSED', () => pm.expect(body.status).to.eql('REVERSED'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": {{timestamp}},\n  \"transId\": \"{{transId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/reverse", "host": ["{{baseUrl}}"], "path": ["reverse"] },
        "description": "Отмена до подтверждения переводит платёж в cancelled, после подтверждения — в refunded, а бронь снова становится неоплаченной. Повторный вызов вернёт 10018."
      }
    },
    {
      "name": "5. Status — статус транзакции",
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": ["pm.collectionVariables.set('timestamp', Date.now());"]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "const body = pm.response.json();",
              "pm.test('статус известен', () => pm.expect(['CREATED', 'CONFIRMED', 'REVERSED']).to.include(body.status));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": {{timestamp}},\n  \"transId\": \"{{transId}}\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/status", "host": ["{{baseUrl}}"], "path": ["status"] },
        "description": "Вызывается, если /confirm завершился таймаутом или ошибкой сервера."
      }
    },
    {
      "name": "Негативные сценарии",
      "item": [
        {
          "name": "10001 — неверный пароль",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('400', () => pm.response.to.have.status(400));",
                  "pm.test('errorCode 10001', () => pm.expect(pm.response.json().errorCode).to.eql('10001'));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "basic",
              "basic": [
                { "key": "username", "value": "{{username}}", "type": "string" },
                { "key": "password", "value": "wrong-password", "type": "string" }
              ]
            },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": 1698361456728,\n  \"params\": {\n    \"order_id\": \"{{orderId}}\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/check", "host": ["{{baseUrl}}"], "path": ["check"] }
          }
        },
        {
          "name": "10006 — неизвестный serviceId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('errorCode 10006', () => pm.expect(pm.response.json().errorCode).to.eql('10006'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": 999999,\n  \"timestamp\": 1698361456728,\n  \"params\": {\n    \"order_id\": \"{{orderId}}\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/check", "host": ["{{baseUrl}}"], "path": ["check"] }
          }
        },
        {
          "name": "10007 — несуществующий order_id",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('errorCode 10007', () => pm.expect(pm.response.json().errorCode).to.eql('10007'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": 1698361456728,\n  \"params\": {\n    \"order_id\": \"0000000000000000\"\n  }\n}"
            },
            "url": { "raw": "{{baseUrl}}/check", "host": ["{{baseUrl}}"], "path": ["check"] }
          }
        },
        {
          "name": "10011 — неверная сумма",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const uuid = require('uuid');",
                  "pm.collectionVariables.set('badTransId', uuid.v4());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('errorCode 10011', () => pm.expect(pm.response.json().errorCode).to.eql('10011'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": 1698361456728,\n  \"transId\": \"{{badTransId}}\",\n  \"params\": {\n    \"order_id\": \"{{orderId}}\"\n  },\n  \"amount\": 100\n}"
            },
            "url": { "raw": "{{baseUrl}}/create", "host": ["{{baseUrl}}"], "path": ["create"] }
          }
        },
        {
          "name": "10014 — неизвестный transId",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('errorCode 10014', () => pm.expect(pm.response.json().errorCode).to.eql('10014'));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"serviceId\": {{serviceId}},\n  \"timestamp\": 1698361456728,\n  \"transId\": \"00000000-0000-0000-0000-000000000000\"\n}"
            },
            "url": { "raw": "{{baseUrl}}/status", "host": ["{{baseUrl}}"], "path": ["status"] }
          }
        }
      ]
    }
  ]
}
