PROJECT_NAME="UzWellness API"
API_PREFIX="/api"
ENVIRONMENT="local"
DEBUG=false

DATABASE_URL="postgresql+asyncpg://sanotour:sanotour@postgres:5432/sanotour"
TEST_DATABASE_URL="postgresql+asyncpg://sanotour:sanotour@localhost:5432/sanotour_test"
REDIS_URL="redis://redis:6379/0"
APP_DATABASE_URL="postgresql+asyncpg://sanotour:sanotour@postgres:5432/sanotour"
APP_REDIS_URL="redis://redis:6379/0"

JWT_SECRET_KEY="change-me-use-a-long-random-secret"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

CORS_ORIGINS='["http://localhost:3000","https://uzwellness.com","https://www.uzwellness.com"]'

INITIAL_SUPER_ADMIN_EMAIL="admin@uzwellness.com"
INITIAL_SUPER_ADMIN_PASSWORD="change-me"

UPLOAD_DIR="uploads"
UPLOAD_URL_PREFIX="/uploads"
MAX_UPLOAD_SIZE_MB=50
IMAGE_MAX_PIXELS=64000000
IMAGE_MAX_DIMENSION=1920
IMAGE_WEBP_QUALITY=85

# Uzum Bank Merchant API — the customer pays in the Uzum Bank app and Uzum
# calls POST /api/payments/uzum/{check,create,confirm,reverse,status} with
# HTTP Basic auth. Username/password/serviceId are agreed with Uzum; the
# webhooks reject every request while these are empty.
UZUM_SERVICE_ID=0
UZUM_MERCHANT_USERNAME=""
UZUM_MERCHANT_PASSWORD=""
UZUM_TRANSACTION_TIMEOUT_MINUTES=30

# Uzum Checkout — card payments on our own site (separate product from the
# Merchant API above). Terminal id and API key come from Uzum per environment;
# while they are empty POST /payments/uzum-checkout/create answers 503.
UZUM_CHECKOUT_API_URL="https://test-chk-api.uzumcheckout.uz"
UZUM_CHECKOUT_TERMINAL_ID=""
UZUM_CHECKOUT_API_KEY=""
# Both redirect URLs must be https — Uzum rejects http with error 2000.
UZUM_CHECKOUT_SUCCESS_URL="https://uzwellness.com/payment/success"
UZUM_CHECKOUT_FAILURE_URL="https://uzwellness.com/payment/failure"
UZUM_CHECKOUT_SESSION_TIMEOUT_SECS=900
# Auto-fiscalization is switched on per terminal by Uzum. While it is on every
# /payment/register must carry the tax data below (Uzum answers 3045 without
# it): merchant INN plus the IKPU/packaging codes of the sold service from
# https://tasnif.soliq.uz — Uzum validates both against that catalogue (3055).
UZUM_CHECKOUT_AUTOFISCALIZATION=true
UZUM_CHECKOUT_TIN=""
# 10204001001000000 = "Гостиничные услуги (за проживание)", packaging 1504157 = "сутки"
UZUM_CHECKOUT_SPIC=""
UZUM_CHECKOUT_PACKAGE_CODE=""
UZUM_CHECKOUT_VAT_PERCENT=0

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="https://api.uzwellness.com/api/auth/google/callback"
OAUTH_FRONTEND_REDIRECT_URL="https://uzwellness.com/auth/callback"

# EMAIL_BACKEND: "log" prints emails; "smtp" sends via SMTP; "resend" sends via
# the Resend HTTPS API (port 443) — use this if the host blocks outbound SMTP.
EMAIL_FROM="noreply@uzwellness.com"
EMAIL_BACKEND="log"
SMTP_HOST="smtp.timeweb.ru"
SMTP_PORT=465
SMTP_USERNAME=""
SMTP_PASSWORD=""
SMTP_USE_TLS=false
SMTP_USE_SSL=true
# Resend (https://resend.com) — set EMAIL_BACKEND="resend"
RESEND_API_KEY=""

RATE_LIMIT_ENABLED=true
TRUSTED_PROXY_IPS='[]'

DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE_SECONDS=3600
