# Source-controlled mirror of /etc/systemd/system/uzwellness-api.service on
# the VPS. Keep this in sync by hand when the live unit changes.
#
# The live unit on the VPS was named uzwellness.service until it was
# renamed to match CLAUDE.md's documented `systemctl restart uzwellness-api`
# — see the rename steps in the chat/PR that introduced this file.

[Unit]
Description=UzWellness API
After=network.target postgresql.service

[Service]
User=root
Group=root

WorkingDirectory=/var/www/uzwellness-api
EnvironmentFile=/var/www/uzwellness-api/.env

RuntimeDirectory=uzwellness
RuntimeDirectoryMode=0755

ExecStart=/var/www/uzwellness-api/.venv/bin/uvicorn app.main:app \
    --uds /run/uzwellness/uvicorn.sock

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
